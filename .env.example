# Copy to .env (gitignored) and adjust. Prefix AM_ maps to Settings fields.
AM_DATABASE_URL=postgresql+asyncpg://am:am@localhost:5433/assistant_memory

# --- Web admin / Google OAuth (B7) ---------------------------------------
# Public base URL the app is reached at; must match the OAuth redirect URI host.
AM_BASE_URL=http://localhost:8000
# Signed-session secret. Generate one (do NOT reuse this placeholder):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AM_SESSION_SECRET=change-me-to-a-long-random-string
# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
AM_GOOGLE_CLIENT_ID=
AM_GOOGLE_CLIENT_SECRET=
# Pins who the owner is: the Google account that logs in as owner (your gmail).
AM_OWNER_EMAIL=
# AM_OWNER_GOOGLE_SUB=   # optional; the owner's Google `sub` once known

# --- Test database (developers only) --------------------------------------
# The suite runs against its OWN database and refuses to start without this. It must NOT be
# the database the app uses: tests that read rows they did not create pass by luck, and four
# of ours did exactly that until the app's database was refreshed under them.
#   createdb assistant_memory_test
#   AM_DATABASE_URL=<that url> uv run alembic upgrade head     # repeat when migrations land
AM_TEST_DATABASE_URL=

# --- Operator language (install step zero, B.13 A-6) -----------------------
# The language the operator chose to be spoken to in. WRITTEN AND READ BY AGENTS
# ONLY — the installing agent records the step-zero answer here, re-reads it on any
# rerun or fresh session, and seeds it into the operator profile once the owner
# credential exists; the server never reads this key. Any human-language name works
# (e.g. "Russian", "English", "Português").
# AM_OPERATOR_LANGUAGE=

# --- Space routing (optional pre-provisioning) -----------------------------
# The conventions-home space id. On a stock install you LEAVE THIS UNSET: the
# structural bootstrap creates the home space itself and records its id in the
# database install-settings store, in the same transaction (B.13 A-1) — no manual
# space step and no restart is part of the install. Set it only to PRE-PROVISION a
# specific existing space as the home; the bootstrap adopts it into the store only
# when the space EXISTS **and the owner account holds a membership in it** — the
# same two-part contract every consumer of the recorded id enforces (the recorded
# id then rules; this variable is not read again). A pre-provisioned space obtains
# that membership by being created under the owner account, or by that account
# being granted a membership before this id is set; a space the owner cannot see
# is refused by name at the seed stage.
# Identity is always an ID, never a name — space names are not unique, and the
# name-based lookup is what once produced a full duplicate of the conventions.
# AM_CONVENTIONS_SPACE_ID=

# AM_FEEDBACK_SPACE_ID -- the maintainer's own single-installation channel for the
#   shipped `feedback` capability. NOT part of the stock install (decision F-12):
#   not provisioned, not configured, not gated — leave unset unless you are the
#   maintainer's own deployment.
# AM_FEEDBACK_SPACE_ID=

# For a public deployment, set AM_BASE_URL to the public https URL — it is the
# OAuth issuer and the Google redirect host. It must match a Google "Authorized
# redirect URI" (<AM_BASE_URL>/auth/callback). HOW the URL becomes reachable (a
# reverse proxy, a cloud ingress, a tunnel) is your choice and is not configured
# here; the optional `remote` compose profile shows one tunnel example and reads
# its own two keys, described in docs/setup.md.

# --- Search / embeddings (B6) --------------------------------------------
# "sentence_transformers" loads the real multilingual model (bge-m3) for good
# semantic search — the default for a real instance (the Docker image ships the
# deps; pre-download the model per setup.md §6). Use "deterministic" (no model,
# no ~2GB download) for a quick trial or constrained host; search still works via
# full-text, semantic ranking is weaker.
AM_EMBEDDING_PROVIDER=sentence_transformers
# AM_EMBEDDING_MODEL=BAAI/bge-m3

# --- Actionable layer: scheduler + cheap reason tier (optional, OFF) ------
# AM_SCHEDULER_ENABLED=true
# AM_SCHEDULER_REASONER=openai         # "stub" = deterministic no-op (no key needed)
# AM_OPENAI_API_KEY=
# AM_OPENAI_MODEL=gpt-5-mini

# --- Daily Google Drive backup (optional; reuses the Google OAuth client) --
# AM_GDRIVE_REFRESH_TOKEN=             # scripts/gdrive_authorize.py (drive.file scope)
# AM_GDRIVE_FOLDER_NAME=assistant_memory_backups
# AM_GDRIVE_KEEP_LAST=3
